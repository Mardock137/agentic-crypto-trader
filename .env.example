# ============================================================
# AGENTIC CRYPTO TRADER - ENVIRONMENT CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# TRADING SETTINGS
# ------------------------------------------------------------
TRADING_MODE=DEMO # Trading mode: DEMO | REAL
  # - DEMO: Uses Binance Demo Trading (demo.binance.com) - real sandbox orders
  # - REAL: Live trading with real funds (requires KILL_SWITCH=0)
  # - TRADING_MODE is required: if missing or invalid, the bot will not start
KILL_SWITCH=0 # Kill switch: when set to 1, all orders are forced to HOLD regardless of the AI decision
CYCLE_INTERVAL_SECONDS=5400 # Interval between cycles in seconds (required, fail-fast if missing)

# ------------------------------------------------------------
# LOG LEVEL
# ------------------------------------------------------------
LOG_LEVEL=INFO # Log level: DEBUG | INFO | WARNING | ERROR

# ------------------------------------------------------------
# AI / MACHINE LEARNING
# ------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
CLAUDE_API_KEY=your_claude_api_key

# ------------------------------------------------------------
# TELEGRAM
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ------------------------------------------------------------
# BINANCE
# ------------------------------------------------------------
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
BINANCE_DEMO_API_KEY=your_binance_demo_api_key
BINANCE_DEMO_SECRET_KEY=your_binance_demo_secret_key
BINANCE_DEMO_BASE_URL=https://demo-api.binance.com/api

# ------------------------------------------------------------
# ALPHA VANTAGE (crypto news)
# ------------------------------------------------------------
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key
